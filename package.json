{
  "name": "@gowthamgts/pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "A collection of independently installable pi extensions.",
  "type": "module",
  "license": "MIT",
  "author": "Gowtham Gopalakrishnan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gowthamgts/pi-stuff.git"
  },
  "homepage": "https://github.com/gowthamgts/pi-stuff#readme",
  "bugs": {
    "url": "https://github.com/gowthamgts/pi-stuff/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "test": "pnpm --recursive --if-present run test",
    "check:load": "pnpm --recursive --if-present run check:load"
  },
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ]
  }
}
