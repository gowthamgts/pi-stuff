{
  "name": "@gowthamgts/pi-typesafe-bash-guard",
  "version": "0.1.0",
  "description": "A pi extension that uses TypeSafe AI to review and gate bash commands before execution.",
  "type": "module",
  "license": "MIT",
  "author": "Gowtham Gopalakrishnan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gowthamgts/pi-stuff.git",
    "directory": "extensions/typesafe-bash-guard"
  },
  "homepage": "https://github.com/gowthamgts/pi-stuff/tree/main/extensions/typesafe-bash-guard#readme",
  "bugs": {
    "url": "https://github.com/gowthamgts/pi-stuff/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "typesafe-ai",
    "bash",
    "security",
    "command-guard"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check:load": "pi --offline --no-extensions -e ./index.ts --list-models openai-codex"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
